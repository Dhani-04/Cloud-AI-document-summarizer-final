# ==========================================
# STREAMLIT SECRETS CONFIGURATION TEMPLATE
# Copy these values into your Streamlit Cloud "Secrets" panel
# or locally to .streamlit/secrets.toml
# ==========================================

# Supabase Cloud Project Configuration
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-or-service-role-key"

# AI Model Configuration (Gemini API Key)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY = "AIzaSy..."

# Storage Bucket Name
SUPABASE_STORAGE_BUCKET = "documents"
